<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <TestingPlatformDisableCustomTestTarget>true</TestingPlatformDisableCustomTestTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lang\CodeWF.Toolkit.Lang\CodeWF.Toolkit.Lang.csproj" />
    <ProjectReference Include="..\..\src\Core\CodeWF.Toolkit.Core\CodeWF.Toolkit.Core.csproj" />
    <ProjectReference Include="..\..\src\Files\CodeWF.Toolkit.Files\CodeWF.Toolkit.Files.csproj" />
    <ProjectReference Include="..\..\src\Image\CodeWF.Toolkit.Image\CodeWF.Toolkit.Image.csproj" />
    <ProjectReference Include="..\..\src\Logging\CodeWF.Toolkit.Logging\CodeWF.Toolkit.Logging.csproj" />
    <ProjectReference Include="..\..\src\Logging\CodeWF.Toolkit.Logging.Microsoft\CodeWF.Toolkit.Logging.Microsoft.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <AssemblyMetadata Include="CodeWF.BuildTimestamp" Value="2026-01-02T03:04:05.0000000Z" />
    <EmbeddedResource Include="Lang/Resources/*.json" />
    <EmbeddedResource Include="Lang/Resources/*.xml" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Core\TestDatas\**" Link="TestDatas\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\logo.png" Link="logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
