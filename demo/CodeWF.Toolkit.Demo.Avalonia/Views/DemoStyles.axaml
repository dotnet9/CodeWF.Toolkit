<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 外壳按钮集中在同一层定义，避免窗口局部样式覆盖 Ribbon 尺寸。 -->
  <Style Selector="Button.qk-btn,ToggleButton.qk-btn">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.st-btn">
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.st-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource StudioRaised}" />
  </Style>
  <!--  演示页通用外观：卡片 / 标题 / 说明 / 代码块 / 行 / 小按钮（随色板与深浅模式自动换色）  -->
  <Style Selector="Border.card">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="BorderBrush" Value="{DynamicResource TabControlSeparatorBorderBrush}" />
  </Style>
  <Style Selector="TextBlock.h">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.sub">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource StudioMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.k">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource StudioMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource StudioMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="SelectableTextBlock.code">
    <Setter Property="FontFamily" Value="Consolas,Cascadia Mono,Menlo,monospace" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="SelectableTextBlock.output">
    <Setter Property="FontFamily" Value="Consolas,Cascadia Mono,Menlo,monospace" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Background" Value="#14808080" />
  </Style>
  <Style Selector="StackPanel.row">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="8" />
  </Style>
  <Style Selector="Button.b">
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource StudioSurface}" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="18" /></Style>

  <Style Selector="ToggleButton.nav-group TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
  </Style>
  <Style Selector="ToggleButton.nav-group /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.nav-group:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.nav-group:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioRaised}" />
  </Style>
  <Style Selector="TextBlock.studio-title">
    <Setter Property="FontSize" Value="26" />
  </Style>
  <Style Selector="Button.demo-action, Button.studio-button, Button.b">
    <Setter Property="Theme" Value="{DynamicResource OutlineButton}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="MinHeight" Value="30" />
  </Style>
  <Style Selector="Button.rbn-cmd,Button.nav-leaf">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.rbn-cmd /template/ ContentPresenter#PART_ContentPresenter, Button.nav-leaf /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
  </Style>
  <Style Selector="Button.rbn-cmd:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.nav-leaf:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioRaised}" />
  </Style>
  <Style Selector="Button.rbn-cmd.selected /template/ ContentPresenter#PART_ContentPresenter, Button.nav-leaf.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioAccent}" />
  </Style>
  <Style Selector="Button.rbn-cmd:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.nav-leaf:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightActive}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
  </Style>
  <Style Selector="Button.rbn-cmd:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.nav-leaf:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SemiColorDisabledFill}" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorDisabledText}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <!-- 分类页签使用 Semi 线形模板，避免模板与内容重复留白。 -->
  <Style Selector="TabStrip#RibbonTabStrip TabStripItem">
    <Setter Property="Height" Value="42" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TabStrip#RibbonTabStrip TabStripItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>

  <Style Selector="Button.rbn-cmd">
    <Setter Property="MinWidth" Value="95" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="Button.rbn-cmd.compact"><Setter Property="MinWidth" Value="80" /><Setter Property="Padding" Value="4,3" /></Style>
  <Style Selector="Button.rbn-cmd StackPanel.ribbon-content"><Setter Property="Orientation" Value="Vertical" /></Style>
  <Style Selector="Button.rbn-cmd.small"><Setter Property="HorizontalContentAlignment" Value="Left" /></Style>
  <Style Selector="Button.rbn-cmd.small StackPanel.ribbon-content"><Setter Property="Orientation" Value="Horizontal" /></Style>
  <Style Selector="Button.nav-leaf"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="FontSize" Value="11.5" /><Setter Property="MinHeight" Value="30" /></Style>
  <Style Selector="ToggleButton.nav-group"><Setter Property="FontSize" Value="11" /><Setter Property="MinHeight" Value="31" /></Style>
  <Style Selector="Button.demo-action"><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Normal" /></Style>
  <Style Selector="Border.studio-card"><Setter Property="CornerRadius" Value="10" /></Style>
  <Style Selector="TextBlock.studio-heading"><Setter Property="FontSize" Value="12" /></Style>
  <!-- 快捷入口比主命令轻，图标与点击热区分别控制。 -->
  <Style Selector="Button.ribbon-quick">
    <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource StudioMuted}" />
    <Setter Property="ToolTip.ShowDelay" Value="400" />
  </Style>
  <Style Selector="PathIcon.ribbon-quick-icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Button.ribbon-quick /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource StudioMuted}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Transitions">
      <Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.ribbon-quick:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StudioRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioAccent}" />
  </Style>
  <Style Selector="Button.ribbon-quick:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightActive}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioAccent}" />
  </Style>
  <Style Selector="Button.ribbon-quick:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
  </Style>
  <Style Selector="PathIcon.nav-chevron">
    <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Setter Property="Transitions">
      <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="PathIcon.nav-chevron.expanded"><Setter Property="RenderTransform" Value="rotate(90deg)" /></Style>
  <!-- 右侧快捷操作遵循原型的文字按钮，保持稳定图标尺寸与键盘焦点。 -->
  <Style Selector="Button.ribbon-action">
    <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource StudioMuted}" />
  </Style>
  <!-- Ribbon 使用整块选中底色；左侧强调线只用于导航行。 -->
  <Style Selector="Button.rbn-cmd"><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="PathIcon.ribbon-icon"><Setter Property="Foreground" Value="{DynamicResource StudioAccent}" /></Style>
  <Style Selector="PathIcon.ribbon-icon:disabled"><Setter Property="Foreground" Value="{DynamicResource SemiColorDisabledText}" /></Style>
  <Style Selector="Border.catalog-group"><Setter Property="BorderThickness" Value="0" /></Style>
  <!--  场景页步骤条：轨道式步骤，当前高亮、已完成打勾  -->
  <Style Selector="Button.scene-step">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource StudioText}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.scene-step:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
  </Style>
  <Style Selector="Button.scene-step.active">
    <Setter Property="BorderBrush" Value="{DynamicResource StudioAccent}" />
    <Setter Property="Background" Value="{DynamicResource StudioRaised}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.scene-step Border.step-no">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource StudioBorder}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.scene-step Border.step-no.done">
    <Setter Property="Background" Value="{DynamicResource StudioSurface}" />
  </Style>
  <Style Selector="Button.scene-step Border.step-no.done > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorSuccess}" />
  </Style>
  <Style Selector="Button.scene-step Border.step-no > TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>

  <!--  外观菜单弹层（原型 appearance-choices 同构）  -->
  <Style Selector="Border.appearance-choices">
    <Setter Property="Background" Value="{DynamicResource StudioSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BoxShadow" Value="0 12 36 0 #33000000" />
  </Style>
  <Style Selector="TextBlock.appearance-title">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="ListBox.mode-chips">
    <Setter Property="Background" Value="{DynamicResource StudioBackground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.mode-chips ListBoxItem">
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button.palette-card">
    <Setter Property="Background" Value="{DynamicResource StudioBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="9" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.palette-badge">
    <Setter Property="Background" Value="{DynamicResource StudioAccent}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.palette-badge TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.palette-tool">
    <Setter Property="Background" Value="{DynamicResource StudioSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Button.appearance-add">
    <Setter Property="Background" Value="{DynamicResource StudioBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StudioBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="FontSize" Value="12" />
  </Style>

</Styles>
