<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             xmlns:vm="using:CodeWF.Toolkit.Demo.Avalonia.ViewModels.Pages"
             x:Class="CodeWF.Toolkit.Demo.Avalonia.Views.Pages.DataTableDemoPage"
             x:DataType="vm:DataTableDemoViewModel" x:CompileBindings="True">
  <ScrollViewer>
    <StackPanel Margin="16,14" Spacing="12">
      <Border Classes="studio-card">
        <StackPanel Spacing="10">
          <TextBlock Text="{codewf:I18n Demo.Catalog.Input}" FontWeight="SemiBold" />
          <TextBlock Classes="studio-hint" Text="{codewf:I18n Demo.Catalog.TableHint}" />
          <TextBox AcceptsReturn="True" Height="80" Text="{Binding Input}" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !IsBusy}">
            <Button Classes="demo-action" Content="{codewf:I18n Demo.Catalog.TableCsv}" Command="{Binding CsvCommand}" />
            <Button Classes="demo-action" Content="{codewf:I18n Demo.Catalog.TableExcel}" Command="{Binding ExcelCommand}" />
          </StackPanel>
          <ProgressBar Height="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
        </StackPanel>
      </Border>
      <Border Classes="studio-card">
        <StackPanel Spacing="10">
          <TextBlock Text="{codewf:I18n Demo.Catalog.Output}" FontWeight="SemiBold" />
          <TreeDataGrid x:Name="PreviewGrid" Height="170" Source="{Binding Source}" />
          <SelectableTextBlock Classes="studio-output" Text="{Binding Output}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
