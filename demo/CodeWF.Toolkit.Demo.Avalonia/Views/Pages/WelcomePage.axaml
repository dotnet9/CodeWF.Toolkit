<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:codewf="https://codewf.com" xmlns:vm="using:CodeWF.Toolkit.Demo.Avalonia.ViewModels" xmlns:pages="using:CodeWF.Toolkit.Demo.Avalonia.Views.Pages"
 x:Class="CodeWF.Toolkit.Demo.Avalonia.Views.Pages.WelcomePage" x:DataType="vm:WelcomeViewModel" x:CompileBindings="True" Classes="studio-page">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="24,20" Spacing="18" MaxWidth="1180">
   <Border Classes="studio-hero">
    <Grid ColumnDefinitions="*,130">
     <StackPanel Spacing="9">
      <TextBlock Text=".NET INFRASTRUCTURE STUDIO" Classes="studio-kicker" />
      <TextBlock Text="CodeWF.Toolkit" Classes="studio-title" />
      <TextBlock Text="{codewf:I18n Demo.Studio.Tagline}" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{codewf:I18n Demo.Studio.Intro}" Classes="studio-muted" MaxWidth="620" HorizontalAlignment="Left" />
      <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
       <TextBlock Text="{codewf:I18n Demo.Studio.PackageCount}" Classes="studio-kicker" />
       <TextBlock Text=".NET 10" Classes="studio-muted" /><TextBlock Text="Windows / macOS / Linux" Classes="studio-muted" />
      </StackPanel>
     </StackPanel>
     <Panel Grid.Column="1" IsHitTestVisible="False">
      <Border Classes="studio-orbit" Width="126" Height="126" />
      <Border Classes="studio-orbit" Width="94" Height="94" RenderTransform="rotate(25deg)" />
      <Border Width="66" Height="66" CornerRadius="20" Background="{DynamicResource StudioGradient}">
       <TextBlock Text=".NET" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
     </Panel>
    </Grid>
   </Border>
   <Border Classes="studio-card">
    <StackPanel Spacing="10">
     <TextBlock Text="{codewf:I18n Demo.Studio.Lab}" Classes="studio-kicker" />
     <TabControl Classes="studio-lab" SelectedIndex="{Binding LabIndex}">
<TabItem Header="{codewf:I18n Demo.Studio.Bus}">
       <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto,Auto"><TextBox Text="{Binding Message}" PlaceholderText="{codewf:I18n Demo.Studio.Message}" /><Button Grid.Column="1" Margin="8,0" Classes="Primary" Content="{codewf:I18n Demo.Studio.Publish}" Command="{Binding PublishCommand}" /><Button Grid.Column="2" Content="{codewf:I18n Demo.Studio.ToggleSubscription}" Command="{Binding ToggleSubscriptionCommand}" /></Grid>
        <Grid ColumnDefinitions="*,24,*,24,*,24,*"><Border Grid.Column="0" Classes="studio-flow-node" Classes.active="{Binding IsPublishing}"><TextBlock Text="{codewf:I18n Demo.Studio.Publisher}" HorizontalAlignment="Center" /></Border><TextBlock Grid.Column="1" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" /><Border Grid.Column="2" Classes="studio-flow-node" Classes.active="{Binding IsRouting}"><TextBlock Text="{codewf:I18n Demo.Studio.EventBus}" HorizontalAlignment="Center" /></Border><TextBlock Grid.Column="3" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" /><Border Grid.Column="4" Classes="studio-flow-node" Classes.active="{Binding IsReceiving}"><TextBlock Text="{codewf:I18n Demo.Studio.Subscriber}" HorizontalAlignment="Center" /></Border><TextBlock Grid.Column="5" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" /><Border Grid.Column="6" Classes="studio-flow-node" Classes.active="{Binding IsLogging}"><TextBlock Text="{codewf:I18n Demo.Studio.LogSink}" HorizontalAlignment="Center" /></Border></Grid>
        <TextBlock Text="{Binding SubscriptionStatus}" Classes="studio-muted" />
        <SelectableTextBlock Text="{Binding BusOutput}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" MinHeight="42" />
        <Button Content="{codewf:I18n Demo.Studio.Open}" Command="{Binding NavigateCommand}" CommandParameter="Demo.Item.Bus" HorizontalAlignment="Left" />
       </StackPanel>
      </TabItem>
      <TabItem Header="{codewf:I18n Demo.Studio.Bytes}">
       <StackPanel Spacing="12">
        <TextBlock Text="{codewf:I18n Demo.Studio.Integer}" Classes="studio-muted" />
        <Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding IntegerText}" /><Button Grid.Column="1" Margin="8,0,0,0" Content="{codewf:I18n Demo.Studio.Encode}" Command="{Binding EncodeCommand}" /></Grid>
        <SelectableTextBlock Text="{Binding ByteOutput}" FontFamily="Consolas" FontSize="18" TextWrapping="Wrap" MinHeight="72" />
        <Button Content="{codewf:I18n Demo.Studio.Open}" Command="{Binding NavigateCommand}" CommandParameter="Demo.Item.NetPacket" HorizontalAlignment="Left" />
       </StackPanel>
      </TabItem>
      <TabItem Header="{codewf:I18n Demo.Studio.Pipeline}">
       <StackPanel Spacing="12">
        <TextBlock Text="{codewf:I18n Demo.Studio.PipelineHint}" Classes="studio-muted" />
        <TextBlock Text="JSON  →  YAML  →  ZIP  →  QR" FontSize="20" Foreground="{DynamicResource StudioAccent}" />
        <ProgressBar Minimum="0" Maximum="4" Value="{Binding PipelineStep}" Height="4" />
        <SelectableTextBlock Text="{Binding PipelineOutput}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" MinHeight="40" />
        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="{codewf:I18n Demo.Studio.RunPipeline}" Command="{Binding PipelineCommand}" /><Button Content="{codewf:I18n Demo.Studio.Output}" Command="{Binding OpenOutputCommand}" IsEnabled="{Binding HasOutput}" /></StackPanel>
       </StackPanel>
      </TabItem>
     </TabControl>
    </StackPanel>
   </Border>
   <TextBlock Text="{codewf:I18n Demo.Studio.Explore}" Classes="studio-kicker" />
   <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Margin="-4"><Panel Grid.Row="0" Grid.Column="0"><Button Classes="studio-capability" Margin="4" Command="{Binding NavigateCommand}" CommandParameter="Demo.Item.Core">
      <StackPanel Spacing="6"><TextBlock Text="⌘" FontSize="22" Foreground="{DynamicResource StudioAccent}" />
      <TextBlock Text="Core" FontWeight="SemiBold" FontSize="14" />
      <TextBlock Text="{codewf:I18n Demo.Text.WelcomePage.View001}" Classes="studio-muted" /></StackPanel></Button></Panel>
<Panel Grid.Row="0" Grid.Column="1"><Button Classes="studio-capability" Margin="4" Command="{Binding NavigateCommand}" CommandParameter="Demo.Item.Bus">
      <StackPanel Spacing="6"><TextBlock Text="↗" FontSize="22" Foreground="{DynamicResource StudioAccent}" />
      <TextBlock Text="EventBus" FontWeight="SemiBold" FontSize="14" />
      <TextBlock Text="{codewf:I18n Demo.Text.WelcomePage.View002}" Classes="studio-muted" /></StackPanel></Button></Panel>
<Panel Grid.Row="0" Grid.Column="2"><Button Classes="studio-capability" Margin="4" Command="{Binding NavigateCommand}" CommandParameter="Demo.Item.FilesFormat">
      <StackPanel Spacing="6"><TextBlock Text="▤" FontSize="22" Foreground="{DynamicResource StudioAccent}" />
      <TextBlock Text="Files" FontWeight="SemiBold" FontSize="14" />
      <TextBlock Text="{codewf:I18n Demo.Text.WelcomePage.View003}" Classes="studio-muted" /></StackPanel></Button></Panel>
<Panel Grid.Row="1" Grid.Column="0"><Button Classes="studio-capability" Margin="4" Command="{Binding NavigateCommand}" CommandParameter="Demo.Item.ImageQr">
      <StackPanel Spacing="6"><TextBlock Text="◇" FontSize="22" Foreground="{DynamicResource StudioAccent}" />
      <TextBlock Text="Image" FontWeight="SemiBold" FontSize="14" />
      <TextBlock Text="{codewf:I18n Demo.Text.WelcomePage.View004}" Classes="studio-muted" /></StackPanel></Button></Panel>
<Panel Grid.Row="1" Grid.Column="1"><Button Classes="studio-capability" Margin="4" Command="{Binding NavigateCommand}" CommandParameter="Demo.Item.LogCore">
      <StackPanel Spacing="6"><TextBlock Text="≡" FontSize="22" Foreground="{DynamicResource StudioAccent}" />
      <TextBlock Text="Logging" FontWeight="SemiBold" FontSize="14" />
      <TextBlock Text="{codewf:I18n Demo.Text.WelcomePage.View005}" Classes="studio-muted" /></StackPanel></Button></Panel>
<Panel Grid.Row="1" Grid.Column="2"><Button Classes="studio-capability" Margin="4" Command="{Binding NavigateCommand}" CommandParameter="Demo.Item.NetPacket">
      <StackPanel Spacing="6"><TextBlock Text="↔" FontSize="22" Foreground="{DynamicResource StudioAccent}" />
      <TextBlock Text="Networking" FontWeight="SemiBold" FontSize="14" />
      <TextBlock Text="{codewf:I18n Demo.Text.WelcomePage.View006}" Classes="studio-muted" /></StackPanel></Button></Panel></Grid>
   <Border Classes="studio-card">
    <Grid ColumnDefinitions="*,Auto">
     <StackPanel Spacing="8"><TextBlock Text="{codewf:I18n Demo.Studio.QuickStart}" FontWeight="SemiBold" /><SelectableTextBlock Text="{Binding InstallCommand}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding CopyStatus}" Classes="studio-muted" /></StackPanel>
     <Button Grid.Column="1" Content="{codewf:I18n Demo.Studio.Copy}" Command="{Binding CopyInstallCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
    </Grid>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
