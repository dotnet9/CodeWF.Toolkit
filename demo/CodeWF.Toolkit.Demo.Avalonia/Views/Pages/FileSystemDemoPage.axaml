<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:codewf="https://codewf.com"
             xmlns:vm="using:CodeWF.Toolkit.Demo.Avalonia.ViewModels.Pages"
             x:Class="CodeWF.Toolkit.Demo.Avalonia.Views.Pages.FileSystemDemoPage"
             x:DataType="vm:FileSystemDemoViewModel" x:CompileBindings="True">
  <ScrollViewer>
    <StackPanel Margin="16,14" Spacing="12">
      <Border Classes="studio-card">
        <StackPanel Spacing="10">
          <TextBlock Text="{codewf:I18n Demo.Catalog.FileSession}" FontWeight="SemiBold" />
          <TextBlock x:Name="SessionHint" Classes="studio-hint" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="demo-action" Content="{codewf:I18n Demo.Catalog.FileStart}" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" />
            <Button Classes="demo-action" Content="{codewf:I18n Demo.Catalog.FileStop}" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="studio-card">
        <StackPanel Spacing="10">
          <TextBlock Text="{codewf:I18n Demo.Catalog.FileOperations}" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding CanOperate}">
            <Button Classes="demo-action" Content="{codewf:I18n Demo.Catalog.FileBrowse}" Command="{Binding BrowseCommand}" />
            <Button Classes="demo-action" Content="{codewf:I18n Demo.Catalog.FileCreate}" Command="{Binding CreateCommand}" />
            <Button Classes="demo-action" Content="{codewf:I18n Demo.Catalog.FileDelete}" Command="{Binding DeleteCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="demo-action" Content="{codewf:I18n Demo.Catalog.FileUpload}" Command="{Binding UploadCommand}" IsEnabled="{Binding CanOperate}" />
            <Button Classes="demo-action" Content="{codewf:I18n Demo.Catalog.FileDownload}" Command="{Binding DownloadCommand}" IsEnabled="{Binding CanOperate}" />
            <Button Classes="demo-action" Content="{codewf:I18n Demo.Catalog.FileCancel}" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}" />
          </StackPanel>
          <ProgressBar Minimum="0" Maximum="100" Height="6" Value="{Binding Progress}" />
          <TreeDataGrid x:Name="PreviewGrid" Height="150" Source="{Binding Source}" />
        </StackPanel>
      </Border>
      <Border Classes="studio-card"><SelectableTextBlock Classes="studio-output" Text="{Binding Output}" /></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
