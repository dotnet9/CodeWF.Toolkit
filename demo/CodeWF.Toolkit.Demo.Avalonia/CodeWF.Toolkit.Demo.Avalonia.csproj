<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>..\..\logo.ico</ApplicationIcon>
    <!-- CI 冒烟用 AOT 发布：Demo 自身与引用的 Toolkit 包都需通过裁剪分析 -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\logo.ico" Link="Assets\logo.ico" />
    <AvaloniaResource Include="..\..\logo.png" Link="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- AOT/裁剪保留清单：Prism/DryIoc、Dock、Magick.NET 等反射重度程序集整树保留 -->
    <TrimmerRootDescriptor Include="Properties\Trimming\TrimmerRoots.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lang Json 后端按输出目录 I18n\ 递归扫描 *.json，Demo 语言资源随包拷贝 -->
    <Content Include="I18n\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <CodeWFAvaloniaSource Condition="'$(CodeWFAvaloniaSource)' == ''">$(MSBuildThisFileDirectory)..\..\..\CodeWF.Avalonia</CodeWFAvaloniaSource>
    <UseLocalCodeWFAvalonia Condition="'$(UseLocalCodeWFAvalonia)' == ''">true</UseLocalCodeWFAvalonia>
  </PropertyGroup>

  <Target Name="CheckStudioSource" BeforeTargets="PrepareForBuild" Condition="'$(UseLocalCodeWFAvalonia)' == 'true'">
    <Error Condition="!Exists('$(CodeWFAvaloniaSource)/src/Controls/CodeWF.Avalonia.Controls/CodeWF.Avalonia.Controls.csproj')"
           Text="StudioTheme 需要最新 CodeWF.Avalonia 源码。请将两个仓库相邻克隆，或通过 -p:CodeWFAvaloniaSource=源码路径 指定位置。使用已包含 StudioTheme 的 NuGet 版本后，可设置 -p:UseLocalCodeWFAvalonia=false。" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Simple" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="Prism.DryIoc.Avalonia" />
    <PackageReference Include="ReactiveUI.Avalonia" />
    <PackageReference Include="Xaml.Behaviors" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Model.ReactiveUI" />
    <!-- PropertyGrid 与 Semi 控件主题所需的传递依赖：依赖包自带的引用在 NuGet 还原后会被裁掉，这里显式补上 -->
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="TreeDataGrid.Avalonia" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="CodeWF.Avalonia.Controls" Condition="'$(UseLocalCodeWFAvalonia)' != 'true'" />
    <PackageReference Include="CodeWF.Avalonia.TreeDataGrid" Condition="'$(UseLocalCodeWFAvalonia)' != 'true'" />
    <PackageReference Include="CodeWF.Avalonia.Dock" Condition="'$(UseLocalCodeWFAvalonia)' != 'true'" />
    <PackageReference Include="CodeWF.Avalonia.Lang" Condition="'$(UseLocalCodeWFAvalonia)' != 'true'" />
    <PackageReference Include="CodeWF.Avalonia.Log" Condition="'$(UseLocalCodeWFAvalonia)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- 同仓库：演示直接调用真实 API（不引用 NuGet 上的旧版本包） -->
    <ProjectReference Include="..\..\src\Core\CodeWF.Toolkit.Core\CodeWF.Toolkit.Core.csproj" />
    <ProjectReference Include="..\..\src\EventBus\CodeWF.Toolkit.EventBus\CodeWF.Toolkit.EventBus.csproj" />
    <ProjectReference Include="..\..\src\EventBus\CodeWF.Toolkit.EventBus.Socket\CodeWF.Toolkit.EventBus.Socket.csproj" />
    <ProjectReference Include="..\..\src\Files\CodeWF.Toolkit.Files\CodeWF.Toolkit.Files.csproj" />
    <ProjectReference Include="..\..\src\Image\CodeWF.Toolkit.Image\CodeWF.Toolkit.Image.csproj" />
    <ProjectReference Include="..\..\src\Logging\CodeWF.Toolkit.Logging\CodeWF.Toolkit.Logging.csproj" />
    <ProjectReference Include="..\..\src\Logging\CodeWF.Toolkit.Logging.Microsoft\CodeWF.Toolkit.Logging.Microsoft.csproj" />
    <ProjectReference Include="..\..\src\Net\CodeWF.Toolkit.NetWeaver\CodeWF.Toolkit.NetWeaver.csproj" />
    <ProjectReference Include="..\..\src\Net\CodeWF.Toolkit.NetWrapper\CodeWF.Toolkit.NetWrapper.csproj" />
  </ItemGroup>


  <ItemGroup Condition="'$(UseLocalCodeWFAvalonia)' == 'true'">
    <ProjectReference Include="$(CodeWFAvaloniaSource)/src/Controls/CodeWF.Avalonia.Controls/CodeWF.Avalonia.Controls.csproj" />
    <ProjectReference Include="$(CodeWFAvaloniaSource)/src/TreeDataGrid/CodeWF.Avalonia.TreeDataGrid/CodeWF.Avalonia.TreeDataGrid.csproj" />
    <ProjectReference Include="$(CodeWFAvaloniaSource)/src/Dock/CodeWF.Avalonia.Dock/CodeWF.Avalonia.Dock.csproj" />
    <ProjectReference Include="$(CodeWFAvaloniaSource)/src/Lang/CodeWF.Avalonia.Lang/CodeWF.Avalonia.Lang.csproj" />
    <ProjectReference Include="$(CodeWFAvaloniaSource)/src/Log/CodeWF.Avalonia.Log/CodeWF.Avalonia.Log.csproj" />
  </ItemGroup>

</Project>
