<prism:PrismApplication xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:prism="http://prismlibrary.com"
                        xmlns:semi="https://irihi.tech/semi"
                        xmlns:codewf="https://codewf.com"
                        x:Class="CodeWF.Toolkit.Demo.Avalonia.App"
                        RequestedThemeVariant="Dark">
  <Application.Styles>
    <semi:SemiTheme Locale="zh-CN" />
    <codewf:ACSemiTheme />
    <codewf:DockSemiTheme />
    <codewf:TreeDataGridSemiTheme />
    <codewf:CodeWFLogTheme />
    <codewf:StudioTheme />
    <StyleInclude Source="avares://CodeWF.Toolkit.Demo.Avalonia/Views/DemoStyles.axaml" />
    <Style Selector="codewf|PropertyGrid">
      <Setter Property="ThemeOverrides" Value="{DynamicResource StudioPropertyGridTheme}" />
    </Style>
  </Application.Styles>
</prism:PrismApplication>
