<prism:PrismApplication xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:prism="http://prismlibrary.com"
                        xmlns:dockmodel="using:Dock.Model.ReactiveUI.Controls"
                        xmlns:semi="https://irihi.tech/semi"
                        xmlns:u="https://irihi.tech/ursa"
                        xmlns:codewf="https://codewf.com"
                        x:Class="CodeWF.Toolkit.Demo.Avalonia.App"
                        RequestedThemeVariant="Dark">
  <!-- 文档与工具模板由 App 注册，使用 Dock 官方内容回收实现跨宿主转移。 -->
  <!-- 应用字体同样覆盖 Dock 浮动窗与弹出层，代码区仍用等宽字体。 -->
  <Application.Resources>
    <FontFamily x:Key="DefaultFontFamily">Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans, sans-serif</FontFamily>
  </Application.Resources>
  <Application.Styles>
    <semi:SemiTheme Locale="zh-CN" />
    <semi:UrsaSemiTheme Locale="zh-CN" />
    <codewf:ACSemiTheme />
    <codewf:DockSemiTheme />
    <codewf:TreeDataGridSemiTheme />
    <codewf:CodeWFLogTheme />
    <codewf:StudioTheme />
    <StyleInclude Source="avares://CodeWF.Toolkit.Demo.Avalonia/Views/DemoStyles.axaml" />
    <!--  StudioPropertyGridTheme 自 v12.2.0-alpha.1 起改为 "Dark"/"Light" 字符串键，
          该协议需要 Avalonia 12.2 的属性存储语义；本仓库钉在 Avalonia 12.1.4，
          直接绑定会让 PropertyGrid.ThemeOverrides(ResourceDictionary)收到字符串而崩溃。
          待 Avalonia 升级至 12.2 后恢复：
          <Style Selector="codewf|PropertyGrid">
            <Setter Property="ThemeOverrides" Value="{DynamicResource StudioPropertyGridTheme}" />
          </Style>  -->
  </Application.Styles>
</prism:PrismApplication>
